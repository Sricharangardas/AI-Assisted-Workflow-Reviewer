    {
      "name": "router.py",
      "version": "1",
      "language": "python",
      "source": "def route(ticket):\n    if ticket.get('category') is None:\n        return 'manual_review'\n    if ticket.get('urgent') == True:\n        return 'priority_queue'\n    if ticket.get('waiting_minutes') >= 30:\n        return 'escalation'\n    return 'normal_queue'\n",
      "evidence": {
        "artifact": "router.py",
        "version": "1",
